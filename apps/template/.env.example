# Copy to .env.local and fill in. Values come from this app's own Supabase
# project, RevenueCat project and PostHog project. Never commit real keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# PostHog project API key (starts with phc_). Leave blank to log events to the
# dev console only. Host defaults to https://us.i.posthog.com.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
