# Copy to .env.local and fill in. Values come from this app's own Supabase
# project and RevenueCat project. Never commit real keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Push notifications (UNJ-1418). Not EXPO_PUBLIC_: app.config.ts reads them at
# build time. EAS_PROJECT_ID comes from `npx eas-cli init`; GOOGLE_SERVICES_JSON
# is the path to the Firebase google-services.json for Android pushes.
EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=
