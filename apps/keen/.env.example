# Copy to .env.local and fill in. Values come from this app's own Supabase
# project and RevenueCat project. Never commit real keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Development builds only: set to 1 to unlock every game and the whole daily
# workout while the paywall (UNJ-1417) is not built. Release builds ignore it.
EXPO_PUBLIC_KEEN_DEV_PREMIUM=
